# Copy this file to .env for local development, or set these as
# environment variables in Render's dashboard for production.

# Generate a real one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Leave unset locally to use sqlite automatically. In production (Render),
# set this to your Supabase project's connection string:
# postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Your deployed Vercel frontend URL(s), comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
